# Ensure jailbreak and standard binary paths are in PATH for subprocesses
paths_to_add = [
    "/var/jb/usr/local/bin",
    "/var/jb/usr/bin",
    "/var/jb/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin"
]
