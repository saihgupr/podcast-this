existing_paths = set(current_path.split(os.pathsep))
new_paths = [p for p in paths_to_add if p not in existing_paths]
if new_paths:
    os.environ["PATH"] = os.pathsep.join(new_paths) + (os.pathsep + current_path if current_path else "")

for cert_path in ["/var/jb/etc/ssl/cert.pem", "/var/jb/etc/ssl/certs/cacert.pem", "/etc/ssl/cert.pem"]:
